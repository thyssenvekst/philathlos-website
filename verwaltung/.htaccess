# Verwaltungsbereich: nur index.php, CSS und JS sind von außen erreichbar.
Options -Indexes
<FilesMatch "^(konfiguration(\.beispiel)?\.php)$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
